    "db:seed:catalog": "tsx scripts/db-seed-catalog.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.14",
