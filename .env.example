# Copy this file to .env.local and fill in real values.
# Never commit .env.local: it holds secrets. Only this example file is tracked.
# With Vercel linked, `npx vercel env pull .env.local` fills most of these for you.

# Neon Postgres connection string. Added automatically by the Vercel + Neon integration.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session cookies. Generate one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
# Base URL of the app (no trailing slash). Set it in production. On Vercel
# previews, leave it unset: the app uses the preview's own URL (VERCEL_URL).
BETTER_AUTH_URL="http://localhost:3000"

# Optional. If missing, order receipt emails are skipped (and logged) instead of sent.
RESEND_API_KEY=""
# Sender address for emails, e.g. "Hermes Express <orders@yourdomain.com>".
EMAIL_FROM=""

# Staff accounts created by `npm run db:seed`. Every password needs at least
# 8 characters; the seed stops with a clear error if one is missing or too short.
# Generate strong ones with: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-admin"
# One barista per branch (barista.<branch>@hermes-express.test), each with their own password.
SEED_BARISTA_TIPAS_PASSWORD="change-me-tipas"
SEED_BARISTA_BGC_PASSWORD="change-me-bgc"
SEED_BARISTA_LAKESHORE_PASSWORD="change-me-lakeshore"
